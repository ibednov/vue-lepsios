    "@unovis/vue": "^1.7.1",
    "@vueuse/core": "^13.9.0",
    "@vueuse/integrations": "^13.9.0",
    "alexbednov-phone-select": "^0.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.0",
    "markdown-it": "^14.0.0",
    "qrcode.vue": "^3.10.0",
    "reka-ui": "^2.5.0",
    "shiki": "^4.0.0",
    "sortablejs": "^1.15.0",
    "tailwind-merge": "^3.3.1",
    "typed.js": "^2.1.0 || ^3.0.0",
    "vue": "^3.5.0",
    "vue-i18n": "^11.0.0",
    "vue-sonner": "^2.0.0"
  },
  "peerDependenciesMeta": {
