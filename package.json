{
  "name": "@lepsios/vue",
  "version": "0.2.1",
  "type": "module",
  "description": "Shared Vue 3 components and composables for Vite and Nuxt applications",
  "license": "UNLICENSED",
  "files": ["src"],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./components/ui/*": {
      "types": "./src/components/ui/*/index.ts",
      "import": "./src/components/ui/*/index.ts"
    },
    "./components/*": "./src/components/*",
    "./composables/*": "./src/composables/*",
    "./lib/*": "./src/lib/*"
  },
  "peerDependencies": {
    "@iconify/vue": "^5.0.0",
    "@unovis/ts": "^1.7.1",
    "@unovis/vue": "^1.7.1",
    "@vueuse/core": "^13.9.0",
    "@vueuse/integrations": "^13.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.5.0",
    "sortablejs": "^1.15.0",
    "tailwind-merge": "^3.3.1",
    "vue": "^3.5.0"
  }
}
