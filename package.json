{
  "name": "@lepsios/vue",
  "version": "0.2.3",
  "type": "module",
  "description": "Shared Vue 3 components and composables for Vite and Nuxt applications",
  "license": "UNLICENSED",
  "files": [
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
