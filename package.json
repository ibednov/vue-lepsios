      "import": "./src/components/ui/*/index.ts"
    },
    "./components/*": "./src/components/*",
    "./composables/*": "./src/composables/*",
    "./lib/*": "./src/lib/*",
    "./utils/*": "./src/utils/*",
    "./assets/css/*": "./src/assets/css/*"
  },
  "peerDependencies": {
    "@iconify/vue": "^5.0.0",
    "@internationalized/date": "^3.12.0",
    "@shikijs/markdown-it": "^4.0.0",
